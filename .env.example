# PostgreSQL/PostGIS connection string for Prisma.
DATABASE_URL="******localhost:5432/discovery?schema=public"

# Explicit local demo fallback to deterministic fictional records (disabled by default for production safety).
LOCAL_DEMO_SEED_ENABLED="false"

# Optional public map style URL for a future MapLibre renderer.
NEXT_PUBLIC_MAP_STYLE_URL=""

# Optional Supabase project values for future auth/storage integration. Do not commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Eatwild importer safeguard: must be explicitly enabled per run.
EATWILD_IMPORT_ENABLED="false"

# Descriptive user agent/contact required for Eatwild import operations.
EATWILD_IMPORT_USER_AGENT="DiscoveryFarmFinderImporter/1.0 (contact: ops@example.com)"

# Importer fetch controls.
EATWILD_IMPORT_THROTTLE_MS="1200"
EATWILD_IMPORT_MAX_CONCURRENCY="2"
EATWILD_IMPORT_TIMEOUT_MS="20000"
EATWILD_IMPORT_MAX_RETRIES="2"
EATWILD_IMPORT_RETRY_BACKOFF_MS="1000"

# Optional geocoding provider for textual location search and importer address geocoding.
# Supported provider: nominatim
GEOCODER_PROVIDER=""
GEOCODER_USER_AGENT=""
